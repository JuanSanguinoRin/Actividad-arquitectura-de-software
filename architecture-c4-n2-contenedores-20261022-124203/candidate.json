  "cards": [
    {
      "dot": "emerald",
      "title": "Decisiones",
      "items": [
        "Sala de espera fuera del monolito: escala sola ante 120.000 compradores",
        "Dos Redis: un pico en la fila no afecta los bloqueos",
        "Venta definitiva en PostgreSQL con UNIQUE (evento, silla)",
        "Tablero y reportes leen de la réplica, no de la primaria"
      ]
    },
    {
      "dot": "amber",
      "title": "Capacidad",
      "items": [
        "Checkout: 10.000 solicitudes/s; con pasarela de 2–10 s hay hasta 100.000 cobros en curso, por eso hilos virtuales",
        "Puerta: 40 torniquetes + 10 lectores de respaldo, ~500 ingresos/h cada uno"
      ]
    },
    {
      "dot": "cyan",
      "title": "Puerta sin red",
      "items": [
        "La app valida contra el padrón en SQLite, sin llamar al servidor",
        "Sincroniza cada 60 s; las transferencias cierran 30 min antes del evento"
      ]
    }
  ]
